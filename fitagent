#!/bin/sh
# Runs the app on macOS and Linux: "./fitagent" opens the window, and "./fitagent help" lists the CLI commands.
# Build the jar first with: mvn package
JAR="$(dirname "$0")/target/fitagent.jar"
if [ ! -f "$JAR" ]; then
    echo "target/fitagent.jar is missing. Build it first with: mvn package"
    exit 1
fi
exec java -jar "$JAR" "$@"
